{
  "name": "subly-extension",
  "version": "1.0.0",
  "type": "module",
  "description": "Subly — enhanced language learning subtitles for YouTube",
  "scripts": {
    "build": "npm run build:popup && npm run build:content && npm run build:background",
    "build:popup": "vite build --config vite.config.ts",
    "build:content": "vite build --config vite.config.content.ts",
    "build:background": "vite build --config vite.config.background.ts",
    "dev": "vite build --config vite.config.ts --watch"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.10",
    "vite-plugin-static-copy": "^1.0.2"
  }
}
